# ------------------------------------------------------------------
# ADOBE FONTS — the one value the typography needs
# ------------------------------------------------------------------
# Copy this file to .env.local and paste in the kit ID of the Adobe
# Fonts Web Project that serves the site's three families:
#
#   Freight Display Pro  Light 300 + Light Italic 300,
#                        Book 400 + Book Italic 400
#   Acumin Pro           Light 300, Regular 400, Medium 500
#   Courier Prime        Regular 400
#
# Create the project at https://fonts.adobe.com/ (My Adobe Fonts →
# Web Projects → Create), set its font-display to "swap", add the
# production domain and localhost to its domain list, then take the
# seven characters out of the embed URL Adobe shows you:
#
#   https://use.typekit.net/XXXXXXX.css   ->   XXXXXXX
#
# Leave it unset and the site renders in its declared fallbacks: the
# layout, hierarchy and composition are identical, the letterforms are
# the system's. Nothing breaks.
# ------------------------------------------------------------------
NEXT_PUBLIC_ADOBE_FONTS_KIT_ID=

# ------------------------------------------------------------------
# SITE URL — the origin the metadata claims
# ------------------------------------------------------------------
# Drives the canonical tag, the Open Graph URLs, robots.txt and
# sitemap.xml. Leave it unset and the site falls back to Vercel's own
# production host (VERCEL_PROJECT_PRODUCTION_URL, set automatically on
# every Vercel build), and below that to zeeshanpashafilms.com.
#
# Set it the day the real domain is connected:
#
#   NEXT_PUBLIC_SITE_URL=https://zeeshanpashafilms.com
#
# Scheme optional, trailing slash ignored. Nothing else changes.
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------
# ENQUIRY ENDPOINT — where the contact form posts
# ------------------------------------------------------------------
# A URL that accepts a JSON POST (Formspree, Basin, a webhook, your
# own route). Leave it unset and the form composes a mailto: to the
# address in src/data/site.ts instead — it still works, it just opens
# the visitor's mail client rather than submitting in place.
# ------------------------------------------------------------------
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
